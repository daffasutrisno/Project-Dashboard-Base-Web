import { useState, useEffect } from "react";
import Chart from "react-apexcharts";
import { ApexOptions } from "apexcharts";

interface ForecastData {
  Date: string;
  "Traffic_Total(TB)": number;
  Lower_Bound?: number;
  Upper_Bound?: number;
}

interface HistoricalData {
  Date: string;
  "Traffic_Total(TB)": number;
  "Traffic_H3I (TB)"?: number;
  "Traffic_IM3 (TB)"?: number;
}

interface ForecastChartProps {
  type: "regional" | "provinsi" | "kabupaten";
  options: string[];
  selectedOption: string;
  onOptionChange: (option: string) => void;
}

type ViewMode = "both" | "forecast";

export default function ForecastChart({
  type,
  options,
  selectedOption,
  onOptionChange,
}: ForecastChartProps) {
  const [forecastData, setForecastData] = useState<ForecastData[]>([]);
  const [historicalData, setHistoricalData] = useState<HistoricalData[]>([]);
  const [loading, setLoading] = useState(true);
  const [viewMode, setViewMode] = useState<ViewMode>("both");

  useEffect(() => {
    const loadData = async () => {
      setLoading(true);
      try {
        // Load forecast data - normalize filename
        let forecastFileName = selectedOption.toLowerCase().trim();

        // Handle special cases for regional/provinsi names
        if (type === "regional") {
          const regionalMap: Record<string, string> = {
            "bali nusra": "bali_nusra",
            "central java": "central_java",
            "east java": "east_java",
          };
          forecastFileName =
            regionalMap[forecastFileName] ||
            forecastFileName.replace(/\s+/g, "_");
        } else if (type === "provinsi") {
          const provinsiMap: Record<string, string> = {
            "daerah istimewa yogyakarta": "daerah_istimewa_yogyakarta",
            "jawa tengah": "jawa_tengah",
            "jawa timur": "jawa_timur",
            "nusa tenggara barat": "nusa_tenggara_barat",
            "nusa tenggara timur": "nusa_tenggara_timur",
          };
          forecastFileName =
            provinsiMap[forecastFileName] ||
            forecastFileName.replace(/\s+/g, "_");
        } else {
          // For kabupaten, just replace spaces with underscores
          forecastFileName = forecastFileName.replace(/\s+/g, "_");
        }

        const forecastPath = `/forecast_data/${type}/${forecastFileName}.csv`;

        const forecastResponse = await fetch(forecastPath);
        if (!forecastResponse.ok) {
          throw new Error(
            `Failed to load forecast data: ${forecastResponse.statusText}`
          );
        }

        const forecastText = await forecastResponse.text();
        const lines = forecastText.split("\n").filter((line) => line.trim());
        if (lines.length < 2) {
          throw new Error("CSV file is empty or invalid");
        }

        const forecastParsed: ForecastData[] = lines.slice(1).map((row) => {
          const values = row.split(",");
          const data: ForecastData = {
            Date: values[0]?.trim() || "",
            "Traffic_Total(TB)": parseFloat(values[1]?.trim() || "0") || 0,
          };
          if (values[2])
            data.Lower_Bound = parseFloat(values[2]?.trim() || "0");
          if (values[3])
            data.Upper_Bound = parseFloat(values[3]?.trim() || "0");
          return data;
        });
        setForecastData(
          forecastParsed.filter((d) => d.Date && !isNaN(d["Traffic_Total(TB)"]))
        );

        // Try to load historical data if available
        try {
          const historicalPath = `/forecast_data/${type}/${forecastFileName}_historical.csv`;
          const historicalResponse = await fetch(historicalPath);
          if (historicalResponse.ok) {
            const historicalText = await historicalResponse.text();
            const historicalLines = historicalText
              .split("\n")
              .filter((line) => line.trim());

            if (historicalLines.length > 1) {
              const historicalParsed: HistoricalData[] = historicalLines
                .slice(1)
                .map((row) => {
                  const values = row.split(",");
                  return {
                    Date: values[0]?.trim() || "",
                    "Traffic_Total(TB)":
                      parseFloat(values[3]?.trim() || "0") || 0,
                    "Traffic_H3I (TB)":
                      parseFloat(values[1]?.trim() || "0") || undefined,
                    "Traffic_IM3 (TB)":
                      parseFloat(values[2]?.trim() || "0") || undefined,
                  };
                });
              setHistoricalData(
                historicalParsed.filter(
                  (d) => d.Date && !isNaN(d["Traffic_Total(TB)"])
                )
              );
            }
          }
        } catch (error) {
          console.log("No historical data available, showing forecast only");
          setHistoricalData([]);
        }
      } catch (error) {
        console.error("Error loading forecast data:", error);
        setForecastData([]);
      } finally {
        setLoading(false);
      }
    };

    if (selectedOption) {
      loadData();
    }
  }, [selectedOption, type]);

  if (loading) {
    return (
      <div className="rounded-2xl border border-gray-200 bg-white px-5 pb-5 pt-5 dark:border-gray-800 dark:bg-white/[0.03] sm:px-6 sm:pt-6">
        <div className="flex h-[400px] items-center justify-center">
          <p className="text-gray-500 dark:text-gray-400">
            Loading chart data...
          </p>
        </div>
      </div>
    );
  }

  if (forecastData.length === 0) {
    return (
      <div className="rounded-2xl border border-gray-200 bg-white px-5 pb-5 pt-5 dark:border-gray-800 dark:bg-white/[0.03] sm:px-6 sm:pt-6">
        <div className="flex h-[400px] items-center justify-center">
          <p className="text-red-500 dark:text-red-400">
            No forecast data available for {selectedOption}
          </p>
        </div>
      </div>
    );
  }

  // Prepare chart data - ALWAYS include both historical and forecast
  const allDates: string[] = [];
  const trafficData: (number | null)[] = [];
  const upperBoundData: (number | null)[] = [];
  const lowerBoundData: (number | null)[] = [];

  // Always add historical data if available
  if (historicalData.length > 0) {
    historicalData.forEach((d) => {
      allDates.push(d.Date);
      trafficData.push(d["Traffic_Total(TB)"]);
      upperBoundData.push(null);
      lowerBoundData.push(null);
    });
  }

  // Always add forecast data
  forecastData.forEach((d) => {
    allDates.push(d.Date);
    trafficData.push(d["Traffic_Total(TB)"]);
    const lower = d.Lower_Bound || d["Traffic_Total(TB)"] * 0.9;
    const upper = d.Upper_Bound || d["Traffic_Total(TB)"] * 1.1;
    upperBoundData.push(upper);
    lowerBoundData.push(lower);
  });

  // Calculate forecast start index
  const forecastStartIndex = historicalData.length > 0 ? historicalData.length : -1;

  // Calculate xaxis min/max based on viewMode
  let xAxisMin: number | undefined = undefined;
  let xAxisMax: number | undefined = undefined;

  if (viewMode === "forecast" && forecastStartIndex >= 0) {
    // Zoom to forecast portion only
    xAxisMin = forecastStartIndex;
    xAxisMax = allDates.length - 1;
  }

  const chartOptions: ApexOptions = {
    legend: {
      show: true,
      position: "top",
      horizontalAlign: "left",
      fontFamily: "Outfit",
      fontSize: "12px",
      markers: {
        width: 8,
        height: 8,
        radius: 2,
      },
      itemMargin: {
        horizontal: 8,
        vertical: 5,
      },
    },
    colors: ["#2E86AB", "#E63946", "#F4A261"],
    chart: {
      fontFamily: "Outfit, sans-serif",
      height: 350,
      type: "line",
      toolbar: {
        show: false,
      },
      zoom: {
        enabled: false,
      },
    },
    stroke: {
      curve: "smooth",
      width: [2, 1.5, 1.5],
      dashArray: [0, 3, 3],
    },
    fill: {
      type: ["gradient", "solid", "solid"],
      gradient: {
        opacityFrom: 0.5,
        opacityTo: 0.1,
      },
      opacity: [1, 0.4, 0.4],
    },
    markers: {
      size: 0,
      strokeColors: "#fff",
      strokeWidth: 2,
      hover: {
        size: 5,
        sizeOffset: 3,
      },
    },
    grid: {
      xaxis: {
        lines: {
          show: false,
        },
      },
      yaxis: {
        lines: {
          show: true,
        },
      },
      borderColor: "#E5E7EB",
      strokeDashArray: 3,
    },
    dataLabels: {
      enabled: false,
    },
    tooltip: {
      enabled: true,
      shared: true,
      intersect: false,
      followCursor: true,
      x: {
        format: "dd MMM yyyy",
      },
      y: {
        formatter: (value: number) => {
          if (value === null || value === undefined) return "";
          return `${value.toFixed(2)} TB`;
        },
      },
    },
    xaxis: {
      type: "category",
      categories: allDates,
      min: xAxisMin,
      max: xAxisMax,
      labels: {
        rotate: 0,
        rotateAlways: false,
        hideOverlappingLabels: true,
        trim: true,
        style: {
          fontSize: "11px",
          colors: "#6B7280",
        },
        formatter: function (value: string, timestamp?: number, opts?: any) {
          if (!value) return "";
          const index = opts?.dataPointIndex;
          // Show labels at start of each month (every ~30 days)
          if (index === 0 || index % 30 === 0 || index === allDates.length - 1) {
            const date = new Date(value);
            const month = date.toLocaleDateString("en-US", { month: "short" });
            const year = date.getFullYear();
            return `${month} ${year}`;
          }
          return "";
        },
      },
      axisBorder: {
        show: false,
      },
      axisTicks: {
        show: false,
      },
      tooltip: {
        enabled: false,
      },
    },
    yaxis: {
      labels: {
        style: {
          fontSize: "12px",
          colors: ["#6B7280"],
        },
        formatter: (value: number) => `${value.toFixed(0)}`,
      },
      title: {
        text: "",
        style: {
          fontSize: "0px",
        },
      },
    },
    annotations:
      forecastStartIndex >= 0
        ? {
            xaxis: [
              {
                x: allDates[forecastStartIndex],
                strokeDashArray: 5,
                borderColor: "#10B981",
                borderWidth: 2,
                label: {
                  borderColor: "#10B981",
                  style: {
                    color: "#fff",
                    background: "#10B981",
                    fontSize: "10px",
                    fontWeight: 600,
                  },
                  text: "Forecast Start",
                  offsetY: 0,
                },
              },
            ],
          }
        : undefined,
  };

  const series: any[] = [
    {
      name: "Traffic",
      type: "area",
      data: trafficData,
    },
    {
      name: "Upper Bound",
      type: "line",
      data: upperBoundData,
    },
    {
      name: "Lower Bound",
      type: "line",
      data: lowerBoundData,
    },
  ];

  return (
    <div className="rounded-2xl border border-gray-200 bg-white px-5 pb-5 pt-5 dark:border-gray-800 dark:bg-white/[0.03] sm:px-6 sm:pt-6">
      <div className="flex flex-col gap-5 mb-6 sm:flex-row sm:justify-between">
        <div className="w-full">
          <h3 className="text-lg font-semibold text-gray-800 dark:text-white/90">
            Traffic Forecast Analysis
          </h3>
          <p className="mt-1 text-gray-500 text-theme-sm dark:text-gray-400">
            {selectedOption} - Daily traffic prediction
          </p>
        </div>
        <div className="flex flex-wrap items-start w-full gap-2 sm:justify-end">
          {/* View Mode Toggle */}
          {historicalData.length > 0 && (
            <div className="flex gap-1 p-1 rounded-lg bg-gray-100 dark:bg-gray-900">
              <button
                onClick={() => setViewMode("both")}
                className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors ${
                  viewMode === "both"
                    ? "bg-white dark:bg-gray-800 text-gray-900 dark:text-white shadow-sm"
                    : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
                }`}
              >
                All Data
              </button>
              <button
                onClick={() => setViewMode("forecast")}
                className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors ${
                  viewMode === "forecast"
                    ? "bg-white dark:bg-gray-800 text-gray-900 dark:text-white shadow-sm"
                    : "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white"
                }`}
              >
                Forecast Only
              </button>
            </div>
          )}

          {/* Region/Province/Kabupaten Selector */
          <select
            value={selectedOption}
            onChange={(e) => onOptionChange(e.target.value)}
            className="px-4 py-2 text-sm font-medium rounded-lg bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-white border border-gray-200 dark:border-gray-700 focus:outline-none focus:ring-2 focus:ring-brand-500"
          >
            {options.map((option) => (
              <option key={option} value={option}>
                {option}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div className="max-w-full overflow-x-auto custom-scrollbar">
        <div className="min-w-[1000px] xl:min-w-full">
          <Chart
            options={chartOptions}
            series={series}
            type="area"
            height={350}
          />
        </div>
      </div>
    </div>
  );
}
